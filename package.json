{
  "name": "agentshield-ai",
  "version": "1.0.0",
  "description": "Continuous Adversarial Security Testing & Vulnerability Auditing for LLM Applications and AI Agents",
  "main": "dist/server/server.js",
  "scripts": {
    "build": "node ./node_modules/typescript/bin/tsc",
    "start": "node dist/server/server.js",
    "dev": "node ./node_modules/typescript/bin/tsc && node dist/server/server.js",
    "test": "node ./node_modules/typescript/bin/tsc && node dist/tests/runAllTests.js"
  },
  "keywords": [
    "ai-security",
    "owasp-llm",
    "prompt-injection",
    "red-teaming",
    "adversarial-fuzzing",
    "agentic-ai",
    "stripe-test"
  ],
  "author": "Datheon AI Startup & SaaS Launch Lab",
  "license": "MIT",
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
